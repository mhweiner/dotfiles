#!/usr/bin/env bash
# Set git global user.name and user.email from the active GitHub CLI account
# when either is unset. Idempotent: does nothing if both are already set.
set -euo pipefail

if ! command -v git >/dev/null 2>&1; then
  exit 0
fi

if git config --global user.email >/dev/null 2>&1 && git config --global user.name >/dev/null 2>&1; then
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "ensure-git-identity: install GitHub CLI, then: gh auth login" >&2
  echo "  Then: git config --global user.name 'Your Name' && git config --global user.email 'you@example.com'" >&2
  exit 0
fi

if ! gh auth status >/dev/null 2>&1; then
  echo "ensure-git-identity: run: gh auth login" >&2
  exit 0
fi

name="$(gh api user --jq '.name // ""' 2>/dev/null || true)"
if [ -z "${name// /}" ]; then
  name="$(gh api user --jq .login 2>/dev/null)"
fi

email="$(
  gh api user/emails --jq '.[] | select(.primary == true) | .email' 2>/dev/null | head -n 1 | tr -d '\n' || true
)"
# gh api user/emails may 404 if the token lacks scope — fall through to noreply
if [ -z "${email// /}" ]; then
  login="$(gh api user --jq .login 2>/dev/null)"
  email="${login}@users.noreply.github.com"
fi

git config --global user.name "$name"
git config --global user.email "$email"
echo "ensure-git-identity: set git user.name='$name' user.email='$email' (from gh)"
