#!/usr/bin/env python3

"""List all open PRs across a GitHub org with pretty formatting.

Usage:
    open-prs <org>            One-shot display
    open-prs <org> --watch    Poll every 5 minutes, full-screen dashboard

Shows open PRs with CI status and recently merged PRs with post-merge
workflow status. In watch mode, successful deploys fade after 15 min
and failures stay on screen until resolved.

PR titles are clickable via OSC 8 hyperlinks (iTerm2, VS Code, etc.).
Requires: gh (GitHub CLI), authenticated.
"""

from __future__ import annotations

import json
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
from datetime import datetime, timedelta, timezone

# ── colors & terminal ───────────────────────────────────────────────────────

BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
WHITE = "\033[37m"
BG_RED = "\033[41m"
BG_GREEN = "\033[42m"
BG_YELLOW = "\033[43m"

CLEAR = "\033[2J\033[H"
HIDE_CURSOR = "\033[?25l"
SHOW_CURSOR = "\033[?25h"

FADE_SECONDS = 15 * 60

# ── graphql ─────────────────────────────────────────────────────────────────

GRAPHQL_QUERY = """\
{{
  open: search(query: "org:{org} is:pr is:open", type: ISSUE, first: 100) {{
    nodes {{
      ... on PullRequest {{
        title url number
        author {{ login }}
        createdAt
        repository {{ name }}
        commits(last: 1) {{
          nodes {{ commit {{ statusCheckRollup {{ state }} }} }}
        }}
      }}
    }}
  }}
  merged: search(query: "org:{org} is:pr is:merged merged:>{cutoff}", type: ISSUE, first: 50) {{
    nodes {{
      ... on PullRequest {{
        title url number
        author {{ login }}
        mergedAt
        mergeCommit {{ oid }}
        repository {{ name }}
      }}
    }}
  }}
}}"""

# ── badges ──────────────────────────────────────────────────────────────────

CI_BADGES = {
    "SUCCESS":  f" {BG_GREEN}{BOLD}{WHITE} ✓ pass {RESET} ",
    "FAILURE":  f" {BG_RED}{BOLD}{WHITE} ✗ fail {RESET} ",
    "ERROR":    f" {BG_RED}{BOLD}{WHITE} ✗ err  {RESET} ",
    "PENDING":  f" {BG_YELLOW}{BOLD}{WHITE} ● run  {RESET} ",
    "EXPECTED": f" {BG_YELLOW}{BOLD}{WHITE} ● run  {RESET} ",
    None:       f" {DIM}no ci{RESET}  ",
}

DEPLOY_BADGES = {
    "success":  f" {BG_GREEN}{BOLD}{WHITE} ✓ deployed  {RESET} ",
    "failure":  f" {BG_RED}{BOLD}{WHITE} ✗ failed    {RESET} ",
    "running":  f" {BG_YELLOW}{BOLD}{WHITE} ● running   {RESET} ",
    "queued":   f" {BG_YELLOW}{BOLD}{WHITE} ◦ queued    {RESET} ",
}

# ── helpers ─────────────────────────────────────────────────────────────────


def age(iso: str) -> str:
    dt = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    delta = datetime.now(timezone.utc) - dt
    days = delta.days
    if days == 0:
        hours = delta.seconds // 3600
        if hours == 0:
            return f"{delta.seconds // 60}m"
        return f"{hours}h"
    if days < 30:
        return f"{days}d"
    return f"{days // 30}mo"


def visible_len(s: str) -> int:
    stripped = re.sub(r"\033\][^\a]*\a", "", s)   # OSC sequences
    stripped = re.sub(r"\033\[[0-9;]*m", "", stripped)  # SGR sequences
    return len(stripped)


def link(url: str, text: str) -> str:
    """Wrap text in an OSC 8 hyperlink."""
    return f"\033]8;;{url}\a{text}\033]8;;\a"


# ── data fetching ───────────────────────────────────────────────────────────


def fetch_prs(org: str) -> tuple[list[dict], list[dict]]:
    """Single GraphQL call → (open_prs, merged_prs)."""
    cutoff = (datetime.now(timezone.utc) - timedelta(hours=4)).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    query = GRAPHQL_QUERY.format(org=org, cutoff=cutoff)
    result = subprocess.run(
        ["gh", "api", "graphql", "-f", f"query={query}"],
        capture_output=True, text=True, check=True,
    )
    data = json.loads(result.stdout)["data"]

    open_prs = []
    for node in data["open"]["nodes"]:
        if not node:
            continue
        rollup = node["commits"]["nodes"][0]["commit"]["statusCheckRollup"]
        open_prs.append({
            "repo": node["repository"]["name"],
            "title": node["title"],
            "url": node["url"],
            "author": node["author"]["login"],
            "age": age(node["createdAt"]),
            "ci": rollup["state"] if rollup else None,
        })
    open_prs.sort(key=lambda p: (p["repo"], p["title"]))

    merged_prs = []
    for node in data["merged"]["nodes"]:
        if not node or not node.get("mergeCommit"):
            continue
        merged_prs.append({
            "repo": node["repository"]["name"],
            "title": node["title"],
            "url": node["url"],
            "author": node["author"]["login"],
            "merged_age": age(node["mergedAt"]),
            "sha": node["mergeCommit"]["oid"],
        })
    merged_prs.sort(key=lambda p: (p["repo"], p["title"]))

    return open_prs, merged_prs


def fetch_workflow_status(org: str, repo: str, sha: str) -> dict | None:
    """Get aggregated workflow run status for a merge commit.

    Returns {"status": ..., "completed_at": datetime | None} or None.
    """
    try:
        result = subprocess.run(
            ["gh", "api",
             f"repos/{org}/{repo}/actions/runs?head_sha={sha}&per_page=100"],
            capture_output=True, text=True, check=True,
        )
        runs = json.loads(result.stdout).get("workflow_runs", [])
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return None

    if not runs:
        return None

    any_running = any(r["status"] == "in_progress" for r in runs)
    any_queued = any(r["status"] in ("queued", "waiting") for r in runs)
    all_completed = all(r["status"] == "completed" for r in runs)

    if any_running:
        return {"status": "running", "completed_at": None}
    if any_queued:
        return {"status": "queued", "completed_at": None}
    if all_completed:
        completed_at = max(
            datetime.fromisoformat(r["updated_at"].replace("Z", "+00:00"))
            for r in runs
        )
        any_failure = any(
            r.get("conclusion") == "failure"
            for r in runs if r["status"] == "completed"
        )
        status = "failure" if any_failure else "success"
        return {"status": status, "completed_at": completed_at}
    return {"status": "running", "completed_at": None}


def build_deployments(
    org: str,
    merged_prs: list[dict],
    failed_cache: dict[str, dict],
) -> list[dict]:
    """Determine which merged PRs to display with deploy status.

    Mutates failed_cache so watch-mode failures persist across refreshes.
    """
    now = datetime.now(timezone.utc)
    deployments: list[dict] = []
    seen_urls: set[str] = set()

    for pr in merged_prs:
        url = pr["url"]
        seen_urls.add(url)
        ws = fetch_workflow_status(org, pr["repo"], pr["sha"])

        if ws is None:
            failed_cache.pop(url, None)
            continue

        if ws["status"] == "failure":
            failed_cache[url] = {"pr": pr, "sha": pr["sha"]}
            deployments.append({**pr, "deploy": ws["status"]})
        elif ws["status"] in ("running", "queued"):
            failed_cache.pop(url, None)
            deployments.append({**pr, "deploy": ws["status"]})
        elif ws["status"] == "success":
            failed_cache.pop(url, None)
            if ws["completed_at"]:
                elapsed = (now - ws["completed_at"]).total_seconds()
                if elapsed < FADE_SECONDS:
                    deployments.append({**pr, "deploy": ws["status"]})

    # Re-check failures that fell out of the search window
    stale: list[str] = []
    for url, cached in failed_cache.items():
        if url in seen_urls:
            continue
        ws = fetch_workflow_status(org, cached["pr"]["repo"], cached["sha"])
        if ws is None or ws["status"] == "success":
            stale.append(url)
        else:
            deployments.append({**cached["pr"], "deploy": ws["status"]})
    for url in stale:
        del failed_cache[url]

    deployments.sort(key=lambda d: (d["repo"], d["title"]))
    return deployments


# ── rendering ───────────────────────────────────────────────────────────────

_BADGE_WIDTH = max(
    visible_len(b) for b in list(CI_BADGES.values()) + list(DEPLOY_BADGES.values())
)


def _render_item(item: dict, width: int) -> list[str]:
    """Render a PR as 2 lines: badge + title, then left-aligned metadata."""
    if item.get("deploy"):
        badge = DEPLOY_BADGES.get(item["deploy"], DEPLOY_BADGES["running"])
        merged_label = (
            f"{RED}merged{RESET}{DIM}"
            if item["deploy"] == "failure"
            else "merged"
        )
        meta = f"{item['author']} · {merged_label} {item['merged_age']} ago"
    else:
        badge = CI_BADGES.get(item.get("ci"), CI_BADGES[None])
        meta = f"{item['author']} · {item['age']} ago"

    badge_vis = visible_len(badge)
    pad_badge = " " * (_BADGE_WIDTH - badge_vis)

    title = item["title"]
    max_title = width - _BADGE_WIDTH - 4
    if len(title) > max(max_title, 12):
        title = title[: max(max_title - 1, 11)] + "…"

    linked_title = link(item["url"], f"{GREEN}{title}{RESET}")
    indent = " " * (_BADGE_WIDTH + 2)

    return [
        f"  {badge}{pad_badge}{linked_title}",
        f"  {indent}{DIM}{meta}{RESET}",
    ]


def render(
    open_prs: list[dict],
    deployments: list[dict],
    org: str,
    watch: bool,
) -> str:
    cols, rows = shutil.get_terminal_size((80, 24))
    now_str = datetime.now().strftime("%H:%M:%S")

    all_items = [
        {**pr, "kind": "open"} for pr in open_prs
    ] + [
        {**d, "kind": "merged"} for d in deployments
    ]

    n_open = len(open_prs)
    n_merged = len(deployments)
    counts = f"{n_open} open"
    if n_merged:
        counts += f", {n_merged} merged"

    header = f"{BOLD}{CYAN}PRs{RESET} {DIM}({org}, {counts})"
    if watch:
        header += (
            f"  ·  updated {now_str}"
            f"  ·  {RESET}{BOLD}r{RESET}{DIM} refresh"
            f"  {RESET}{BOLD}c{RESET}{DIM} clear merged"
            f"  {RESET}{BOLD}q{RESET}{DIM} quit"
        )
    header += RESET

    if not all_items:
        return f"{header}\n\n  {DIM}No PRs.{RESET}\n"

    # Group by repo, open PRs first then merged within each group
    groups: dict[str, list[dict]] = {}
    for item in all_items:
        groups.setdefault(item["repo"], []).append(item)
    for items in groups.values():
        items.sort(key=lambda x: (0 if x["kind"] == "open" else 1, x["title"]))

    repo_names = sorted(groups.keys())

    # 2-column when >= 100 wide and enough repos to benefit
    total_items = sum(len(g) for g in groups.values())
    use_two_cols = cols >= 100 and total_items > 15
    col_width = (cols - 3) // 2 if use_two_cols else cols

    blocks: list[list[str]] = []
    for repo in repo_names:
        lines = [f"  {BOLD}{YELLOW}{repo}{RESET}"]
        for item in groups[repo]:
            lines.extend(_render_item(item, col_width))
        blocks.append(lines)

    if not use_two_cols:
        out = [header]
        for block in blocks:
            out.append("")
            out.extend(block)
        return "\n".join(out)

    # Distribute blocks into 2 columns, balancing line count
    left: list[str] = []
    right: list[str] = []
    lc = rc = 0
    for block in blocks:
        target = left if lc <= rc else right
        if target:
            target.append("")
        target.extend(block)
        if target is left:
            lc += len(block) + (1 if lc else 0)
        else:
            rc += len(block) + (1 if rc else 0)

    max_h = max(len(left), len(right))
    left.extend([""] * (max_h - len(left)))
    right.extend([""] * (max_h - len(right)))
    sep = f" {DIM}│{RESET} "
    out = [header, ""]
    for l_line, r_line in zip(left, right):
        pad = col_width - visible_len(l_line)
        out.append(l_line + " " * max(pad, 0) + sep + r_line)
    return "\n".join(out)


# ── run modes ───────────────────────────────────────────────────────────────


def _loading(msg: str = "Loading") -> None:
    """Print a loading message (overwritten on next write)."""
    sys.stdout.write(f"\r{DIM}{msg}…{RESET}")
    sys.stdout.flush()


def run_once(org: str) -> None:
    _loading("Fetching PRs")
    open_prs, merged_prs = fetch_prs(org)
    if merged_prs:
        sys.stdout.write(f"\r{DIM}Checking workflows…{RESET}")
        sys.stdout.flush()
    deployments = build_deployments(org, merged_prs, {})
    sys.stdout.write("\r\033[K")
    print(render(open_prs, deployments, org, watch=False))


def wait_for_key(timeout: float) -> str | None:
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        ready, _, _ = select.select([sys.stdin], [], [], min(remaining, 0.25))
        if ready:
            return sys.stdin.read(1)


def _draw(output: str) -> None:
    """Clear the alternate screen and draw output from the top."""
    sys.stdout.write(f"\033[H\033[J{output}")
    sys.stdout.flush()


def _draw_loading(msg: str = "Refreshing") -> None:
    """Show a loading indicator at the top of the alternate screen."""
    sys.stdout.write(f"\033[H{DIM}{msg}…{RESET}\033[K")
    sys.stdout.flush()


def run_watch(org: str) -> None:
    old_settings = termios.tcgetattr(sys.stdin)
    failed_cache: dict[str, dict] = {}
    dismissed: set[str] = set()
    first = True
    sys.stdout.write(f"\033[?1049h{HIDE_CURSOR}")
    sys.stdout.flush()
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            _draw_loading("Loading" if first else "Refreshing")
            first = False
            open_prs, merged_prs = fetch_prs(org)
            if merged_prs:
                _draw_loading("Checking workflows")
            deployments = build_deployments(org, merged_prs, failed_cache)
            visible = [d for d in deployments if d["url"] not in dismissed]
            _draw(render(open_prs, visible, org, watch=True))

            key = wait_for_key(300)
            if key in ("q", "\x03"):
                break
            if key == "c":
                dismissed.update(d["url"] for d in deployments)
                visible = [d for d in deployments if d["url"] not in dismissed]
                _draw(render(open_prs, visible, org, watch=True))
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write(f"{SHOW_CURSOR}\033[?1049l")
        sys.stdout.flush()


def main() -> None:
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    flags = {a for a in sys.argv[1:] if a.startswith("-")}

    if not args or "--help" in flags or "-h" in flags:
        print("Usage: open-prs <org> [--watch]", file=sys.stderr)
        sys.exit(1 if not args else 0)

    org = args[0]
    watch = "--watch" in flags or "-w" in flags

    if watch:
        run_watch(org)
    else:
        run_once(org)


if __name__ == "__main__":
    main()
