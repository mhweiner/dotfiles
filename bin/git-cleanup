#!/usr/bin/env bash
# Checkout default branch, pull --prune, drop linked worktrees for merged branches,
# prune stale worktree metadata, delete local branches whose upstream is gone.
set -euo pipefail

usage() {
  echo "Usage: git-cleanup [--force] [branch]" >&2
  echo "  Default branch: main" >&2
  echo "  --force  also remove gone-branch worktrees with tracked local edits" >&2
}

force=0
branch=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --force)
      force=1
      shift
      ;;
    -*)
      echo "git-cleanup: unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -n "$branch" ]]; then
        echo "git-cleanup: unexpected argument: $1" >&2
        usage
        exit 1
      fi
      branch="$1"
      shift
      ;;
  esac
done
branch="${branch:-main}"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "git-cleanup: not a git repository" >&2
  exit 1
fi

primary="$(git worktree list | head -n1 | awk '{print $1}')"
here="$(git rev-parse --show-toplevel)"

if [[ "$here" != "$primary" ]]; then
  echo "git-cleanup: switching to primary worktree: $primary" >&2
fi

cd "$primary"

git checkout "$branch"

if git rev-parse --abbrev-ref "${branch}@{upstream}" >/dev/null 2>&1; then
  git pull -p
else
  git fetch -p 2>/dev/null || true
fi

git worktree prune -v 2>/dev/null || git worktree prune 2>/dev/null || true

gone=()
while IFS= read -r name; do
  [[ -n "$name" ]] && gone+=("$name")
done < <(
  git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
    awk '$2 == "[gone]" {print $1}' |
    grep -vE '^(main|dev|master)$' || true
)

worktree_paths_for_branch() {
  local target="$1"
  local wt_path="" ref="" bname=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == worktree* ]]; then
      wt_path="${line#worktree }"
    elif [[ "$line" == branch* ]]; then
      ref="${line#branch }"
      bname="${ref#refs/heads/}"
      if [[ "$bname" == "$target" && "$wt_path" != "$primary" && -n "$wt_path" ]]; then
        printf '%s\n' "$wt_path"
      fi
      wt_path=""
    elif [[ -z "$line" ]]; then
      wt_path=""
    fi
  done < <(git worktree list --porcelain)
}

# Tracked edits (not ?? / !!). Untracked or ignored-only dirt is safe to force-remove.
worktree_has_tracked_changes() {
  local wt_path="$1"
  local line
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    case "$line" in
      \?\?\ * |\!\!\ *) ;;
      *) return 0 ;;
    esac
  done < <(git -C "$wt_path" status --porcelain --untracked-files=all)
  return 1
}

remove_worktree_path() {
  local wt_path="$1"
  local b="$2"

  echo "git-cleanup: removing worktree $wt_path (branch $b)"
  if git worktree remove --force "$wt_path"; then
    if [[ -d "$wt_path" ]]; then
      rm -rf "$wt_path"
    fi
    return 0
  fi
  echo "git-cleanup: kept branch $b (could not remove $wt_path; see error above)" >&2
  return 1
}

deletable=()
if ((${#gone[@]} > 0)); then
  for b in "${gone[@]}"; do
    kept=0
    while IFS= read -r wt_path; do
      [[ -z "$wt_path" ]] && continue
      if ((force)); then
        remove_worktree_path "$wt_path" "$b" || kept=1
      elif worktree_has_tracked_changes "$wt_path"; then
        echo "git-cleanup: kept branch $b (tracked changes in $wt_path; pass --force to delete)" >&2
        kept=1
      else
        remove_worktree_path "$wt_path" "$b" || kept=1
      fi
    done < <(worktree_paths_for_branch "$b")
    ((kept)) || deletable+=("$b")
  done
fi

git worktree prune 2>/dev/null || true

if ((${#deletable[@]} > 0)); then
  git branch -D "${deletable[@]}"
fi
