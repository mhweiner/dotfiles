#!/usr/bin/env bash
# Checkout default branch, pull --prune, drop linked worktrees for merged branches,
# prune stale worktree metadata, delete local branches whose upstream is gone.
set -euo pipefail

usage() {
  echo "Usage: git-cleanup [branch]" >&2
  echo "  Default branch: main" >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

branch="${1:-main}"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "git-cleanup: not a git repository" >&2
  exit 1
fi

primary="$(git worktree list | head -n1 | awk '{print $1}')"
here="$(git rev-parse --show-toplevel)"

if [[ "$here" != "$primary" ]]; then
  echo "git-cleanup: switching to primary worktree: $primary" >&2
fi

cd "$primary"

git checkout "$branch"

if git rev-parse --abbrev-ref "${branch}@{upstream}" >/dev/null 2>&1; then
  git pull -p
else
  git fetch -p 2>/dev/null || true
fi

git worktree prune -v 2>/dev/null || git worktree prune 2>/dev/null || true

gone=()
while IFS= read -r name; do
  [[ -n "$name" ]] && gone+=("$name")
done < <(
  git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
    awk '$2 == "[gone]" {print $1}' |
    grep -vE '^(main|dev|master)$' || true
)

worktree_paths_for_branch() {
  local target="$1"
  local wt_path="" ref="" bname=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == worktree* ]]; then
      wt_path="${line#worktree }"
    elif [[ "$line" == branch* ]]; then
      ref="${line#branch }"
      bname="${ref#refs/heads/}"
      if [[ "$bname" == "$target" && "$wt_path" != "$primary" && -n "$wt_path" ]]; then
        printf '%s\n' "$wt_path"
      fi
      wt_path=""
    elif [[ -z "$line" ]]; then
      wt_path=""
    fi
  done < <(git worktree list --porcelain)
}

deletable=()
if ((${#gone[@]} > 0)); then
  for b in "${gone[@]}"; do
    kept=0
    while IFS= read -r wt_path; do
      [[ -z "$wt_path" ]] && continue
      echo "git-cleanup: removing worktree $wt_path (branch $b)"
      if ! git worktree remove "$wt_path"; then
        echo "git-cleanup: kept $wt_path and branch $b (uncommitted changes)" >&2
        kept=1
      fi
    done < <(worktree_paths_for_branch "$b")
    ((kept)) || deletable+=("$b")
  done
fi

git worktree prune 2>/dev/null || true

if ((${#deletable[@]} > 0)); then
  git branch -D "${deletable[@]}"
fi
